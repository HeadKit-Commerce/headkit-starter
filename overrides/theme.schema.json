{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://headkit.app/schemas/storefront-theme.json",
  "title": "HeadKit storefront theme",
  "description": "Customer-owned layout modes in overrides/. Dashboard branding still owns colors, fonts, and corners.",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "version": {
      "type": "integer",
      "minimum": 1,
      "description": "Schema version for forward-compatible upgrades."
    },
    "layout": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "navLayout": {
          "type": "string",
          "enum": ["left-logo", "centered-logo", "split"],
          "description": "Primary nav logo placement."
        },
        "navStyle": {
          "type": "string",
          "enum": ["icons", "text-labels"],
          "description": "Desktop header actions presentation."
        },
        "heroLayout": {
          "type": "string",
          "enum": ["inset", "full-bleed", "fixed-height"],
          "description": "Homepage hero carousel shell."
        },
        "homepageNav": {
          "type": "string",
          "enum": ["solid", "overlay-hero"],
          "description": "Nav chrome on the homepage."
        }
      },
      "required": ["navLayout", "navStyle", "heroLayout", "homepageNav"]
    },
    "pdp": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional product-detail chrome. Starter defaults omit this.",
      "properties": {
        "sizeGuideHref": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "pattern": "^/(?!/)[A-Za-z0-9/_-]*$",
          "description": "Internal Size Guide CMS path. PDP Size Guide controls open this page in a modal (e.g. /size-guide). Direct visits still render the page."
        }
      }
    },
    "catalog": {
      "type": "object",
      "additionalProperties": false,
      "description": "Optional catalog presentation. Starter defaults omit this — only badge: tags show until a store allowlists more.",
      "properties": {
        "badgeTags": {
          "type": "array",
          "description": "Product tag names or slugs that render as pills on cards and the PDP. Case-insensitive. Tags prefixed badge: always show.",
          "items": { "type": "string", "minLength": 1, "maxLength": 64 },
          "maxItems": 32
        }
      }
    },
    "figma": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "fileKey": { "type": "string" },
        "referenceFrames": {
          "type": "object",
          "additionalProperties": { "type": "string" }
        }
      }
    }
  },
  "required": ["version", "layout"]
}
