# apps/starter environment — local Docker dev defaults
# Copy to `.env.local` and adjust per environment.

# ---------------------------------------------------------------------------
# HeadKit API keys (REQUIRED) — from the HeadKit dashboard
# ---------------------------------------------------------------------------
NEXT_PUBLIC_HEADKIT_PUBLIC_KEY=pk_live_xxx
HEADKIT_PRIVATE_KEY=sk_live_xxx

# ---------------------------------------------------------------------------
# Frontend URL (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_FRONTEND_URL=http://localhost:3000

# ---------------------------------------------------------------------------
# Image optimization (FE-10)
# ---------------------------------------------------------------------------
# Optional. An extra https image host to allowlist in next.config.ts
# remotePatterns. Leave UNSET for local dev — the build allowlists
# storage.googleapis.com (GCS media + branding) and localhost (local WP)
# unconditionally. Never a wildcard; set to a single concrete host when needed.
# IMAGE_DOMAIN=your-media-domain.com

# ---------------------------------------------------------------------------
# GraphQL gateway (FE-11) — REQUIRED
# ---------------------------------------------------------------------------
# Canonical, single source of truth for the Hive gateway URL. Read by the
# @headkit/sdk transport (auto-detected) and by lib/account-actions.ts via the
# validated env schema (lib/env.ts). REQUIRED: a missing/invalid value fails
# loudly at boot (no silent localhost:4000 fallback). Local Docker default:
NEXT_PUBLIC_GRAPHQL_URL=http://localhost:4000/graphql

# ---------------------------------------------------------------------------
# Analytics (optional)
# ---------------------------------------------------------------------------
NEXT_PUBLIC_GTM_ID=

# ---------------------------------------------------------------------------
# Email marketing public keys (optional fallbacks)
# Store credentials from the HeadKit dashboard Email tab take precedence.
# ---------------------------------------------------------------------------
# NEXT_PUBLIC_KLAVIYO_PUBLIC_KEY=
# NEXT_PUBLIC_HUBSPOT_PORTAL_ID=

# ---------------------------------------------------------------------------
# Build-time request throttling (optional)
# ---------------------------------------------------------------------------
# Proactive cap on concurrent SDK READ requests per process. Prevents the
# prerender burst from tripping managed-WP (Pressable) rate limits (429).
# Mutations (checkout/cart) always bypass the cap. 0 disables. Default: 4.
# HEADKIT_SDK_MAX_CONCURRENT=4

# Next build parallelism (next.config.ts experimental.cpus /
# staticGenerationMaxConcurrency). The worker count defaults to one per 8 GB of
# build-container memory, bounded by cores and capped at 4 — see
# lib/build-parallelism.ts for the measurement. Memory, not cores, is what
# bounds it: an 8 GB machine gets 1 worker, a 16 GB machine 2. Page concurrency
# defaults to 1. Set NEXT_BUILD_CPUS to override in either direction; the
# effective upstream read ceiling is HEADKIT_SDK_MAX_CONCURRENT x workers
# (the SDK cap is per worker process).
# NEXT_BUILD_CPUS=2
# NEXT_STATIC_GEN_CONCURRENCY=1
