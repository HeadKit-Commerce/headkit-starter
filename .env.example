# apps/starter environment — local Docker dev defaults
# Copy to `.env.local` and adjust per environment.

# ---------------------------------------------------------------------------
# Image optimization (FE-10)
# ---------------------------------------------------------------------------
# Optional. An extra https image host to allowlist in next.config.ts
# remotePatterns. Leave UNSET for local dev — the build allowlists
# storage.googleapis.com (GCS media + branding) and localhost (local WP)
# unconditionally. Never a wildcard; set to a single concrete host when needed.
# IMAGE_DOMAIN=cdn.example.com
